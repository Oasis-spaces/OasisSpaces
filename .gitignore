__pycache__/
*.pyc
.DS_Store
nohup.out

# captured spaces are personal data, and even the synthetic demo cloud is
# a generated 7.7MB binary — regenerate it with scripts/make_sample.py
# (the Render build does this at deploy time)
spaces/
.venv/

# OpenSplat build for this Mac (AGPL-3.0, locally patched): build it from
# source on each machine rather than publishing the binary
tools/opensplat
tools/default.metallib

# Copies of finished splats (large binaries, kept out of git)
splats/

# Source videos for Colab runs (large, never committed)
videos/

# OpenSplat built on Colab, reused by tools/colab_pipeline.py
tools/colab-cache/

# Bundles built for another machine
bundle/

# Logs of pipeline runs (tools/colab_pipeline.py)
runs/

# Spirula Studio release (plug-in trainer for stage 4; GPL-3.0, run as a separate program)
tools/spirula-studio/
